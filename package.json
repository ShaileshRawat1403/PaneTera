{
  "name": "panetera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "lint": "tsc --noEmit --project tsconfig.json",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=30000 'test/**/*.test.ts' 'test/**/*.test.tsx'",
    "test:coverage": "node --import tsx --experimental-test-coverage --test --test-concurrency=1 --test-timeout=30000 'test/**/*.test.ts' 'test/**/*.test.tsx'"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mui/icons-material": "^5.16.3",
    "@mui/material": "^5.16.3",
    "axios": "^1.7.2",
    "chokidar": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ipaddr.js": "^1.9.1",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.14.9",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.10"
  }
}
