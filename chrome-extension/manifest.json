{
  "manifest_version": 3,
  "name": "Tessera Browser Operator",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Modular browser operator extension linked to Tessera Workbench.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_permissions": [
    "tabs",
    "tabGroups"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-context": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Capture Web Context for Tessera Portal"
    }
  }
}
