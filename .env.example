# .env.example
# Copy this file to .env and replace the placeholder token with a strong secret.

PORT=4000
# IMPORTANT: change this before starting the server!
PORTAL_TOKEN=changeme-12345

# Optionally set a custom workspace root (defaults to /Users/Shailesh/MYAIAGENTS)
# WORKSPACE_ROOT=/path/to/your/workspaces

# Optional live app previews
SOOTHSAYER_LIVE_URL=https://ops-soothsayer-web-production.up.railway.app

# AI API keys
# Set your keys below to enable natural language processing:
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
