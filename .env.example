# .env.example
# Copy this file to .env and replace the placeholder token with a strong secret.

PORT=4000
# IMPORTANT: change this before starting the server!
PORTAL_TOKEN=changeme-12345

# Cross-origin access. CORS fails closed: with this unset, the server grants no
# cross-origin request at all. That is the right default -- the app is served
# same-origin in both development (Vite proxies /api) and production, so neither
# needs an entry here. Set it only to allow a genuinely separate front-end
# origin, as an exact, comma-separated list of scheme://host[:port].
# ALLOWED_ORIGINS=https://panetera.example,https://admin.panetera.example

# Optional stable identity for the authenticated local operator. When omitted,
# audit records remain honestly `unknown / operator-unattributed`.
# PORTAL_OPERATOR_ID=local-owner
# PORTAL_OPERATOR_LABEL=Local owner

# Optionally set a custom workspace root (defaults to /Users/Shailesh/MYAIAGENTS)
# WORKSPACE_ROOT=/path/to/your/workspaces

# Optional live app previews
SOOTHSAYER_LIVE_URL=https://ops-soothsayer-web-production.up.railway.app

# AI API keys
# Set your keys below to enable natural language processing:
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
