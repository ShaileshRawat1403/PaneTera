// tsconfig.json
{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "server", "shared", "test"],
  // test/mock-files is written at runtime by staticStructureScan.test.ts and
  // deliberately contains unresolvable imports, which is the condition under
  // test. Its cleanup is not guaranteed on early exit, so excluding it keeps
  // lint deterministic rather than dependent on whether a test finished.
  "exclude": ["test/mock-files"]
}
